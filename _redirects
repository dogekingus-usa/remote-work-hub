# RemoteWorkHub.net - Cloudflare Pages Redirect Rules + Security Blocks
# Format: [source] [target] [status] — first match wins

# www -> non-www canonicalization
https://www.remoteworkhub.net/* https://remoteworkhub.net/:splat 301

# Security: Block sensitive file extensions (fleet standard, 2026-07-08 CTO sweep)
/*.py      /404 404
/*.bat     /404 404
/*.sh      /404 404
/*.ps1     /404 404
/*.key     /404 404
/*.pem     /404 404
/*.env     /404 404
/*.csr     /404 404
/*.crt     /404 404
/*.p12     /404 404
/*.pfx     /404 404
/*.sql     /404 404
/*.sqlite  /404 404
/*.rdp     /404 404

# Security: Block config files from being served (wrangler.toml confirmed live-exposed 200)
/wrangler.toml  /404 404
/_routes.json   /404 404

# Legacy /blog/ paths -> root level (template leftovers, defensive catch-all)
/blog/          /all-articles  301
/blog/*         /:splat        301
