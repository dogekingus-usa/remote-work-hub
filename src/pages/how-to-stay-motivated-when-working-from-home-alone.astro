---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/how-to-stay-motivated-when-working-from-home-alone.html?raw';

const title = "How to Stay Motivated When Working from Home Alone | RemoteWorkHub.net";
const description = "Learn how to stay motivated when working from home alone. Practical strategies to beat isolation, maintain energy, and thrive as a solo remote worker.";
const canonical = "https://remoteworkhub.net/how-to-stay-motivated-when-working-from-home-alone";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'RemoteWorkHub' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>