---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/best-destinations-us-remote-2026.html?raw';

const title = "Best US Cities for Remote Workers in 2026: Complete Comparison Guide";
const description = "Comprehensive comparison of the best US cities for remote workers in 2026 including Austin, Denver, Raleigh, Portland, Salt Lake City, and Tampa. Real cost of living data, internet speeds, coworking spaces, tax considerations, and quality of life rankings.";
const canonical = "https://remoteworkhub.net/best-destinations-us-remote-2026";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'RemoteWorkHub' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>