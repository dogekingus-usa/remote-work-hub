---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/optimize-resume-linkedin-hybrid-remote-2026.html?raw';

const title = "How to Optimize Your Resume and LinkedIn for Hybrid and Remote Work in 2026 | remoteworkhub.net";
const description = "Learn how to optimize your resume and LinkedIn profile for hybrid and remote job applications in 2026. Keywords, formatting tips, remote-specific skills, and ATS optimization strategies.";
const canonical = "https://remoteworkhub.net/optimize-resume-linkedin-hybrid-remote-2026";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'RemoteWorkHub' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>