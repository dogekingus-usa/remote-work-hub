---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/salary-transparency-laws-remote-workers-2026.html?raw';

const title = "Salary Transparency Laws for Remote Workers in 2026: What You Need to Know | Remote Work Hub";
const description = "Salary transparency laws are reshaping remote work in 2026. Learn which states and countries require pay ranges on job postings, how to use salary data in negotiations, and what remote workers must know to stay compliant and get paid fairly.";
const canonical = "https://remoteworkhub.net/salary-transparency-laws-remote-workers-2026";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'RemoteWorkHub' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>