---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const cat = 'Productivity';
---

<BaseLayout title="Setting Boundaries as a Remote Worker: Protect Your Time and Sanity — Remote Work Hub" description="Remote work blurs the lines between work and life. Learn how to set and maintain healthy boundaries with your employer, your team, and yourself.">
  <article class="mx-auto max-w-4xl px-4 py-8">
    <header class="mb-8">
      <p class="text-sm text-brand-500 font-medium mb-2">{cat}</p>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">Setting Boundaries as a Remote Worker: Protect Your Time and Sanity — Remote Work Hub</h1>
      <time class="text-sm text-gray-500">2026</time>
      
      <div class="mt-3 flex gap-2 flex-wrap">
        <span class="text-xs bg-gray-700 text-gray-300 px-2 py-1 rounded">productivity</span>
      </div>
    </header>
    <div class="prose prose-invert prose-gray max-w-none">
      <p>Remote work blurs the lines between work and life. Learn how to set and maintain healthy boundaries with your employer, your team, and yourself.</p>
    </div>
  </article>
</BaseLayout>
