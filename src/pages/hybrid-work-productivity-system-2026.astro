---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/hybrid-work-productivity-system-2026.html?raw';

const title = "Hybrid Work Productivity System: Tools, Schedules, and Routines for Office and Home | remoteworkhub.net";
const description = "Build a hybrid work productivity system that works whether you are in the office or at home. Tools, schedules, daily routines, and performance tracking for hybrid professionals in 2026.";
const canonical = "https://remoteworkhub.net/hybrid-work-productivity-system-2026";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'RemoteWorkHub' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>