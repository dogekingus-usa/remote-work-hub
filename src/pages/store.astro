---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/store.html?raw';

const title = "Products \u0026 Store — remoteworkhub.net";
const description = "Premium digital products for remoteworkhub.net. Boost your productivity, career, and financial success with our curated toolkit.";
const canonical = "https://remoteworkhub.net/store";
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
  </div>
</BaseLayout>