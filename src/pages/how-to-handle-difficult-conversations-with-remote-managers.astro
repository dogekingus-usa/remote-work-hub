---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/how-to-handle-difficult-conversations-with-remote-managers.html?raw';

const title = "How to Handle Difficult Conversations with Remote Managers | remoteworkhub.net";
const description = "Handling Difficult Conversations with Remote Managers - Tips and Strategies | Remote Work Hub How to Handle Difficult Conversatio";
const canonical = "https://remoteworkhub.net/how-to-handle-difficult-conversations-with-remote-managers";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'RemoteWorkHub' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>