---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/checklist.html?raw';

const title = "The Remote Work Success Setup Checklist — remoteworkhub.net";
const description = "Set yourself up for productivity, balance, and career growth while working remotely. Downloadable interactive checklist for remoteworkhub.net.";
const canonical = "https://remoteworkhub.net/checklist";
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
  </div>
</BaseLayout>