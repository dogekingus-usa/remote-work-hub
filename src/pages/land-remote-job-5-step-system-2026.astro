---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/land-remote-job-5-step-system-2026.html?raw';

const title = "How to Land a Remote Job: 5-Step System for 2026 | RemoteWorkHub";
const description = "A proven 5-step system for landing a remote job in 2026. From identifying the best companies to acing remote interviews and negotiating offers.";
const canonical = "https://remoteworkhub.net/land-remote-job-5-step-system-2026";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'RemoteWorkHub' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>