---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/disclaimer.html?raw';

const title = "Disclaimer | RemoteWorkHub";
const description = "Disclaimer for RemoteWorkHub. Legal disclaimers regarding remote work advice, affiliate links, and use of our content.";
const canonical = "https://remoteworkhub.net/disclaimer.html";
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
  </div>
</BaseLayout>