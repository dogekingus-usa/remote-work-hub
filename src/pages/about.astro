---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/about.html?raw';

const title = "About Remote Work Hub — Work From Anywhere, Thrive Everywhere";
const description = "Remote Work Hub helps you find remote jobs, build a location-independent career, and thrive as a digital nomad.";
const canonical = "https://remoteworkhub.net/about.html";
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
  </div>
</BaseLayout>