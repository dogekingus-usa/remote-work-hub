---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const cat = 'Jobs';
---

<BaseLayout title="Remote Healthcare Jobs 2026: Complete Guide to Medical Work-from-Home Careers & Salaries | RemoteWorkHub" description="Complete guide to remote healthcare jobs in 2026. Discover work-from-home medical careers including medical coding, telehealth nursing, medical transcription, healthcare administration, clinical data management, and medical writing. Salaries from $28K to $200K+. Includes certification requirements, job boards, and step-by-step entry plans.">
  <article class="mx-auto max-w-4xl px-4 py-8">
    <header class="mb-8">
      <p class="text-sm text-brand-500 font-medium mb-2">{cat}</p>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">Remote Healthcare Jobs 2026: Complete Guide to Medical Work-from-Home Careers & Salaries | RemoteWorkHub</h1>
      <time class="text-sm text-gray-500">2026</time>
      
      <div class="mt-3 flex gap-2 flex-wrap">
        <span class="text-xs bg-gray-700 text-gray-300 px-2 py-1 rounded">jobs</span>
        <span class="text-xs bg-gray-700 text-gray-300 px-2 py-1 rounded">healthcare</span>
        <span class="text-xs bg-gray-700 text-gray-300 px-2 py-1 rounded">medical</span>
        <span class="text-xs bg-gray-700 text-gray-300 px-2 py-1 rounded">career</span>
      </div>
    </header>
    <div class="prose prose-invert prose-gray max-w-none">
      <p>Complete guide to remote healthcare jobs in 2026. Discover work-from-home medical careers including medical coding, telehealth nursing, medical transcription, healthcare administration, clinical data management, and medical writing. Salaries from $28K to $200K+. Includes certification requirements, job boards, and step-by-step entry plans.</p>
    </div>
  </article>
</BaseLayout>
