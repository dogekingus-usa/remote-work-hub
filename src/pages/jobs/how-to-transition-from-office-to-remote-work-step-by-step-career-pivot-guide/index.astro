---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const cat = 'Jobs';
---

<BaseLayout title="How to Transition from Office to Remote Work: A Step-by-Step Career Pivot Guide (2026)" description="A comprehensive step-by-step guide to transitioning from office-based to remote work in 2026. Learn how to find remote jobs, restructure your resum...">
  <article class="mx-auto max-w-4xl px-4 py-8">
    <header class="mb-8">
      <p class="text-sm text-brand-500 font-medium mb-2">{cat}</p>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">How to Transition from Office to Remote Work: A Step-by-Step Career Pivot Guide (2026)</h1>
      <time class="text-sm text-gray-500">2026</time>
      
      <div class="mt-3 flex gap-2 flex-wrap">
        <span class="text-xs bg-gray-700 text-gray-300 px-2 py-1 rounded">jobs</span>
      </div>
    </header>
    <div class="prose prose-invert prose-gray max-w-none">
      <p>A comprehensive step-by-step guide to transitioning from office-based to remote work in 2026. Learn how to find remote jobs, restructure your resum...</p>
    </div>
  </article>
