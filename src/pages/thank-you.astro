---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/thank-you.html?raw';

const title = "Thank You | Remote Work Hub";
const description = "Thank you for subscribing to Remote Work Hub.";
const canonical = "https://remoteworkhub.net/thank-you";
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
  </div>
</BaseLayout>