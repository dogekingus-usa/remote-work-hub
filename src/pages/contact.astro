---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/contact.html?raw';

const title = "Contact Us — Remote Work Hub";
const description = "Get in touch with Remote Work Hub. Have a remote work tip or a question about digital nomad life? We would love to hear from you.";
const canonical = "https://remoteworkhub.net/contact";
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
  </div>
</BaseLayout>