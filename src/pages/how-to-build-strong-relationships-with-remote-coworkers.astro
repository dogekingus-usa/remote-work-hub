---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/how-to-build-strong-relationships-with-remote-coworkers.html?raw';

const title = "How to Build Strong Relationships with Remote Coworkers | RemoteWorkHub.net";
const description = "Learn how to build strong relationships with remote coworkers. Practical strategies for connection, trust, and collaboration in a distributed team environment.";
const canonical = "https://remoteworkhub.net/how-to-build-strong-relationships-with-remote-coworkers";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'RemoteWorkHub' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>