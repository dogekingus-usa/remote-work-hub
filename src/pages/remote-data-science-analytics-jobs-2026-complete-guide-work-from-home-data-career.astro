---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/remote-data-science-analytics-jobs-2026-complete-guide-work-from-home-data-career.html?raw';

const title = "Remote Data Science \u0026 Analytics Jobs 2026: Complete Guide to Landing a Work-From-Home Data Career | RemoteWorkHub";
const description = "Complete guide to remote data science and analytics jobs in 2026. Top companies hiring remote data professionals, salary ranges from $55K-$250K+, essential skills, certifications, tools, portfolio tips, and how to break into data science with or without experience.";
const canonical = "https://remoteworkhub.net/remote-data-science-analytics-jobs-2026-complete-guide-work-from-home-data-career";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'RemoteWorkHub' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>