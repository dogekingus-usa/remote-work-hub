---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const cat = 'Remote Work';
---

<BaseLayout title="The RTO Backlash of 2026: Why Top Talent Is Quitting Return-to-Office Mandates | RemoteWorkHub" description="2026 data shows 8 in 10 enterprises losing top talent to strict RTO mandates. 65% of Gen Z would quit. Here's what's really happening in the return-to-office war.">
  <article class="mx-auto max-w-4xl px-4 py-8">
    <header class="mb-8">
      <p class="text-sm text-brand-500 font-medium mb-2">{cat}</p>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">The RTO Backlash of 2026: Why Top Talent Is Quitting Return-to-Office Mandates | RemoteWorkHub</h1>
      <time class="text-sm text-gray-500">2026-06-04</time>
      
      <div class="mt-3 flex gap-2 flex-wrap">
        <span class="text-xs bg-gray-700 text-gray-300 px-2 py-1 rounded">remote-work</span>
        <span class="text-xs bg-gray-700 text-gray-300 px-2 py-1 rounded">RTO</span>
        <span class="text-xs bg-gray-700 text-gray-300 px-2 py-1 rounded">career</span>
        <span class="text-xs bg-gray-700 text-gray-300 px-2 py-1 rounded">talent-retention</span>
        <span class="text-xs bg-gray-700 text-gray-300 px-2 py-1 rounded">future-of-work</span>
      </div>
    </header>
    <div class="prose prose-invert prose-gray max-w-none">
      <p>2026 data shows 8 in 10 enterprises losing top talent to strict RTO mandates. 65% of Gen Z would quit. Here's what's really happening in the return-to-office war.</p>
    </div>
  </article>
</BaseLayout>
