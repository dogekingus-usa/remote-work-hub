---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const cat = 'Meme Coins';
---

<BaseLayout title="10 Side Hustles for Remote Workers in 2026 | RemoteWorkHub" description="Remote workers are perfectly positioned for side hustles. Learn 10 side income opportunities that complement your remote career.">
  <article class="mx-auto max-w-4xl px-4 py-8">
    <header class="mb-8">
      <p class="text-sm text-brand-500 font-medium mb-2">{cat}</p>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">10 Side Hustles for Remote Workers in 2026 | RemoteWorkHub</h1>
      <time class="text-sm text-gray-500">2026</time>
      
      <div class="mt-3 flex gap-2 flex-wrap">
        <span class="text-xs bg-gray-700 text-gray-300 px-2 py-1 rounded">meme-coins</span>
      </div>
    </header>
    <div class="prose prose-invert prose-gray max-w-none">
      <p>Remote workers are perfectly positioned for side hustles. Learn 10 side income opportunities that complement your remote career.</p>
    </div>
  </article>
</BaseLayout>
