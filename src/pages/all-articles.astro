---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/all-articles.html?raw';

const title = "All Articles — Remote Work Hub";
const description = "Browse all 320 articles on Remote Work Hub";
const canonical = "https://remoteworkhub.net/all-articles";
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
  </div>
</BaseLayout>