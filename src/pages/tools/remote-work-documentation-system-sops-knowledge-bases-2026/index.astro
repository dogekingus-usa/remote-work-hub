---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const cat = 'Tools';
---

<BaseLayout title="How to Create a Remote Work Documentation System: SOPs and Knowledge Bases for Distributed Teams" description="Learn how to build a remote work documentation system with SOPs, knowledge bases, and process guides. Keep your distributed team aligned, efficient...">
  <article class="mx-auto max-w-4xl px-4 py-8">
    <header class="mb-8">
      <p class="text-sm text-brand-500 font-medium mb-2">{cat}</p>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">How to Create a Remote Work Documentation System: SOPs and Knowledge Bases for Distributed Teams</h1>
      <time class="text-sm text-gray-500">2026</time>
      
      <div class="mt-3 flex gap-2 flex-wrap">
        <span class="text-xs bg-gray-700 text-gray-300 px-2 py-1 rounded">tools</span>
      </div>
    </header>
    <div class="prose prose-invert prose-gray max-w-none">
      <p>Learn how to build a remote work documentation system with SOPs, knowledge bases, and process guides. Keep your distributed team aligned, efficient...</p>
    </div>
  </article>
</BaseLayout>
