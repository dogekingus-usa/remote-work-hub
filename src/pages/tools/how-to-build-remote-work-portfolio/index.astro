---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const cat = 'Tools';
---

<BaseLayout title="How to Build a Remote Work Portfolio That Lands High-Paying Gigs | remoteworkhub.net" description="A strong portfolio is your ticket to remote work success. Learn how to build a portfolio that showcases your skills and convinces clients to hire you.">
  <article class="mx-auto max-w-4xl px-4 py-8">
    <header class="mb-8">
      <p class="text-sm text-brand-500 font-medium mb-2">{cat}</p>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">How to Build a Remote Work Portfolio That Lands High-Paying Gigs | remoteworkhub.net</h1>
      <time class="text-sm text-gray-500">2026</time>
      
      <div class="mt-3 flex gap-2 flex-wrap">
        <span class="text-xs bg-gray-700 text-gray-300 px-2 py-1 rounded">tools</span>
      </div>
    </header>
    <div class="prose prose-invert prose-gray max-w-none">
      <p>A strong portfolio is your ticket to remote work success. Learn how to build a portfolio that showcases your skills and convinces clients to hire you.</p>
    </div>
  </article>
</BaseLayout>
