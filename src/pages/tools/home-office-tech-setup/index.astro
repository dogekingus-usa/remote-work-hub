---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const cat = 'Tools';
---

<BaseLayout title="The Ultimate Home Office Tech Setup for Remote Workers in 2026 | Remote Work Hub" description="The complete guide to building a home office tech setup for remote work in 2026. From ergonomics and monitors to audio, lighting, and connectivity ...">
  <article class="mx-auto max-w-4xl px-4 py-8">
    <header class="mb-8">
      <p class="text-sm text-brand-500 font-medium mb-2">{cat}</p>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">The Ultimate Home Office Tech Setup for Remote Workers in 2026 | Remote Work Hub</h1>
      <time class="text-sm text-gray-500">2026</time>
      
      <div class="mt-3 flex gap-2 flex-wrap">
        <span class="text-xs bg-gray-700 text-gray-300 px-2 py-1 rounded">tools</span>
      </div>
    </header>
    <div class="prose prose-invert prose-gray max-w-none">
      <p>The complete guide to building a home office tech setup for remote work in 2026. From ergonomics and monitors to audio, lighting, and connectivity ...</p>
    </div>
  </article>
