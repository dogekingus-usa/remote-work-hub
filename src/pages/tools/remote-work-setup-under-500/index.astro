---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const cat = 'Tools';
---

<BaseLayout title="How to Create a Remote Work Setup Under $500" description="Build a complete remote work setup for under $500. Budget-friendly home office equipment, ergonomic tips, and essential tools for working from home.">
  <article class="mx-auto max-w-4xl px-4 py-8">
    <header class="mb-8">
      <p class="text-sm text-brand-500 font-medium mb-2">{cat}</p>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">How to Create a Remote Work Setup Under $500</h1>
      <time class="text-sm text-gray-500">2026</time>
      
      <div class="mt-3 flex gap-2 flex-wrap">
        <span class="text-xs bg-gray-700 text-gray-300 px-2 py-1 rounded">tools</span>
      </div>
    </header>
    <div class="prose prose-invert prose-gray max-w-none">
      <p>Build a complete remote work setup for under $500. Budget-friendly home office equipment, ergonomic tips, and essential tools for working from home.</p>
    </div>
  </article>
</BaseLayout>
