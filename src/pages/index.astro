---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="RemoteWorkHub — Remote Work Guides" description="Your ultimate guide to remote work, digital nomad lifestyle, and location independence.">
  <section class="mx-auto max-w-6xl px-4 py-12">
    <div class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl font-bold text-brand-500 mb-4">RemoteWorkHub</h1>
      <p class="text-xl text-gray-300 max-w-2xl mx-auto">
        Your guide to remote work — jobs, productivity, tools, and the digital nomad lifestyle.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <a href="/jobs/" class="block rounded-xl border border-gray-600 bg-dark-700/50 p-6 hover:border-brand-500/50 hover:bg-dark-700 transition-all">
        <h2 class="text-lg font-semibold text-brand-500 mb-2">Remote Jobs</h2>
        <p class="text-sm text-gray-400">Find legitimate remote jobs and avoid scams.</p>
      </a>
      <a href="/productivity/" class="block rounded-xl border border-gray-600 bg-dark-700/50 p-6 hover:border-brand-500/50 hover:bg-dark-700 transition-all">
        <h2 class="text-lg font-semibold text-brand-500 mb-2">Productivity</h2>
        <p class="text-sm text-gray-400">Async communication, focus, and work-from-home tips.</p>
      </a>
      <a href="/tools/" class="block rounded-xl border border-gray-600 bg-dark-700/50 p-6 hover:border-brand-500/50 hover:bg-dark-700 transition-all">
        <h2 class="text-lg font-semibold text-brand-500 mb-2">Tools</h2>
        <p class="text-sm text-gray-400">Best tools for remote teams and solo workers.</p>
      </a>
    </div>
  </section>
</BaseLayout>
