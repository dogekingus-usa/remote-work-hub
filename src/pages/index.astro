---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/index.html?raw';

const title = "Remote Work Hub 🌍 Work From Anywhere, Thrive Everywhere";
const description = "Work From Anywhere, Thrive Everywhere 🌍 curated guides, tools, and systems to help you level up.";
const canonical = "https://remoteworkhub.net";
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
  </div>
</BaseLayout>