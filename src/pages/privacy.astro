---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/privacy.html?raw';

const title = "Privacy Policy — Remote Work Hub";
const description = "Privacy policy for Remote Work Hub. How we collect, use, and protect your data.";
const canonical = "https://remoteworkhub.net/privacy.html";
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
  </div>
</BaseLayout>